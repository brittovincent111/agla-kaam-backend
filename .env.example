NODE_ENV=development
PORT=3000

# Local MongoDB (see docker-compose.yml). Swap for a MongoDB Atlas URI in production.
MONGODB_URI=mongodb://localhost:27017/service-reminder

# Used to sign business login tokens. Generate a real random secret before deploying.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=30d

# Free plan customer cap (see project.md).
FREE_TIER_CUSTOMER_LIMIT=25

# Razorpay Dashboard → Settings → API Keys. Use TEST mode keys here — never
# put live keys in a dev/example env. Webhook secret is set separately under
# Settings → Webhooks when you add the endpoint (subscriptions/webhook/razorpay).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=change-me
RAZORPAY_WEBHOOK_SECRET=change-me

# Google Cloud Console → APIs & Services → Credentials → the OAuth 2.0
# "Web client" ID (not the Android client ID) — this is the audience the
# backend verifies Google ID tokens against.
GOOGLE_WEB_CLIENT_ID=446089701899-lni2flud3k84sceqm02b1su5kqs4c23d.apps.googleusercontent.com

# S3 bucket for business logo/signature uploads (IAM user needs
# s3:PutObject/GetObject/DeleteObject on this bucket).
AWS_REGION=ap-south-1
S3_BUCKET=change-me
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me

# --- Email Infrastructure (Amazon SES + Cloudflare) ---
# Default transactional sender for OTP / password reset (Amazon SES)
EMAIL_FROM=no-reply@aglakaam.app
# Optional SMTP fallback (only if you want to use an external SMTP server instead of Amazon SES)
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=

# Optional — only needed for POST /subscriptions/verify-play-purchase.
# Google Cloud Console → IAM → Service Accounts → create one, grant it
# "Financial data" access in Play Console → Users & permissions, then
# download its JSON key and paste the whole thing here as one line.
# Leave unset until the Play Console subscription products exist — see
# DECISIONS.md.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"play-api@your-project.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}
GOOGLE_PLAY_PACKAGE_NAME=com.aglakaam.app

# Only needed for POST /auth/apple. Defaults to com.aglakaam.app in code —
# only set this if the iOS bundle identifier ever diverges from Android's.
APPLE_BUNDLE_ID=com.aglakaam.app
APPLE_IAP_KEY_ID=RLKH743GXJ
APPLE_IAP_ISSUER_ID=15cd4077-9adb-4b50-9d04-b2e9253c2ceb
APPLE_IAP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----"
APPLE_IAP_ENVIRONMENT=production

# Optional — Sign in with Apple token revoke on account deletion (App Store
# Review Guideline 5.1.1(v)). A "Sign in with Apple" key from Certificates,
# Identifiers & Profiles → Keys (NOT the In-App Purchase key above); paste the
# .p8 contents on one line with literal \n for newlines. Left unset, sign-in
# still works and deletion skips the revoke with a warning in the log.
APPLE_TEAM_ID=ABCDE12345
APPLE_SIGNIN_KEY_ID=XYZ987WVUT
APPLE_SIGNIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----"

# Optional — Agla Kaam Lead Finder
# Google Places API key (Text Search New API). If omitted, falls back to approved directory sandbox.
GOOGLE_PLACES_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Daily request safety limit (default: 500)
LEAD_FINDER_DAILY_LIMIT=200
# Monthly request safety limit (default: 10000)
# Google bills our searches as Text Search Enterprise. India price list (billing account in India):
# 7,000 free a month, then $10.50 per 1,000. Global list: 1,000 free, then $35 per 1,000.
# Searches stop LEAD_FINDER_SAFETY_GAP_PERCENT below the free amount (7,000 − 20% = 5,600),
# unless LEAD_FINDER_ALLOW_PAID=true.
LEAD_FINDER_FREE_MONTHLY=7000
LEAD_FINDER_SAFETY_GAP_PERCENT=20
LEAD_FINDER_MONTHLY_LIMIT=5600
LEAD_FINDER_ALLOW_PAID=false

# Public address customers open links on (no /api), e.g. invoice pay pages.
PUBLIC_API_URL=https://agla-kaam-api.velocrew.in

# Optional: the website (no trailing slash). When set, short links become
# https://aglakaam.app/r/<code> and the service record / invoice links open the
# website's pages, which read their data from this API. Leave unset to keep the
# API's own HTML pages. Deploy the website pages BEFORE setting this.
# PUBLIC_WEB_URL=https://aglakaam.app

# Amazon SES & Bulk Email Marketing
# Region (defaults to ap-south-1)
AWS_SES_REGION=ap-south-1
# Dedicated SES credentials (if SES runs in a different AWS account than S3)
# AWS_SES_ACCESS_KEY_ID=
# AWS_SES_SECRET_ACCESS_KEY=
# Verified SES sender email address
SES_FROM_EMAIL=hello@example.com
# Optional reply-to address
SES_REPLY_TO_EMAIL=support@aglakaam.app
# Queue sending throughput controls (emails per second)
SES_RATE_LIMIT_PER_SECOND=10
# Recipient batch size per worker lease
SES_BATCH_SIZE=25
# Different addresses emailed per 24 hours across all campaigns, follow-ups included.
EMAIL_DAILY_LIMIT=200
# Maximum retry attempts per throttled email
SES_MAX_RETRIES=3
# Retry backoff delay in milliseconds
SES_RETRY_DELAY_MS=2000
# Unsubscribe base link host (defaults to PUBLIC_API_URL or https://aglakaam.app)
UNSUBSCRIBE_BASE_URL=https://aglakaam.app

# Development / testing safety override (redirects ALL outgoing emails to this address)
EMAIL_OVERRIDE_TO=

# --- WhatsApp Cloud API (marketing campaigns from +91 80758 30924) ---
# Permanent System User token with whatsapp_business_messaging + whatsapp_business_management.
WHATSAPP_ACCESS_TOKEN=EAAGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# WhatsApp Business Account id (WhatsApp Manager → account info), to list templates.
WHATSAPP_WABA_ID=1234567890123456
# Meta app → Settings → Basic → App secret. Verifies webhook signatures.
WHATSAPP_APP_SECRET=0123456789abcdef0123456789abcdef
# Any long random string; type the same value in the Meta webhook settings.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=any-long-random-text-also-pasted-in-meta
WHATSAPP_GRAPH_VERSION=v23.0
# Testing: every WhatsApp send goes to this number instead (digits, with country code). Empty in production.
WHATSAPP_OVERRIDE_TO=
# Different people per 24 hours across all campaigns (a new number's limit is 250).
WHATSAPP_DAILY_LIMIT=250
WHATSAPP_RATE_PER_SECOND=5

# --- Outreach sending hours (email + WhatsApp campaigns), India time ---
# Start hour inclusive - end hour exclusive. "0-24" = any time.
OUTREACH_SEND_HOURS=10-19
# Weekdays allowed, 0 = Sunday ... 6 = Saturday. "0-6" = every day.
OUTREACH_SEND_DAYS=1-6

# --- Outreach money limit ---
# What outreach may cost a month. WhatsApp marketing messages are what costs
# (Meta India ₹0.8631 + 18% GST ≈ ₹1.02 each); Google stays free, email is paise.
# 20% is kept unspent: ₹3,000 → ₹2,400 → about 2,350 WhatsApp messages a month.
OUTREACH_MONTHLY_BUDGET_INR=3000
OUTREACH_BUDGET_GAP_PERCENT=20
WHATSAPP_COST_PER_MESSAGE_INR=1.02

# --- Added: names the backend reads that were missing here ---
# Website address for customer links (/r/, /invoice/, /service-record/).
PUBLIC_WEB_URL=https://aglakaam.app
# Admin panel login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password
# Email sending: "smtp" or "ses". SMTP settings for app emails.
EMAIL_PROVIDER=ses
# SMTP is used only when SMTP_HOST and SMTP_USER are both set,
# e.g. SMTP_HOST=smtp.example.com, SMTP_USER=no-reply@aglakaam.app.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=change-me
# Amazon SES keys for outreach email.
AWS_SES_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SES_SECRET_ACCESS_KEY=change-me
# Refuses to start if the AWS keys belong to a different account,
# e.g. AWS_EXPECTED_ACCOUNT_ID=123456789012. Empty: no check.
AWS_EXPECTED_ACCOUNT_ID=
# Shown with their defaults; tests point them at local fakes.
GOOGLE_PLACES_BASE_URL=https://places.googleapis.com
GOOGLE_PLACES_COST_PER_CALL_USD=0.0105
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com

