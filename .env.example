NODE_ENV=development
PORT=3000

# Local MongoDB (see docker-compose.yml). Swap for a MongoDB Atlas URI in production.
MONGODB_URI=mongodb://localhost:27017/service-reminder

# Used to sign business login tokens. Generate a real random secret before deploying.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=30d

# Free plan customer cap (see project.md).
FREE_TIER_CUSTOMER_LIMIT=25

# Razorpay Dashboard → Settings → API Keys. Use TEST mode keys here — never
# put live keys in a dev/example env. Webhook secret is set separately under
# Settings → Webhooks when you add the endpoint (subscriptions/webhook/razorpay).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=change-me
RAZORPAY_WEBHOOK_SECRET=change-me

# Google Cloud Console → APIs & Services → Credentials → the OAuth 2.0
# "Web client" ID (not the Android client ID) — this is the audience the
# backend verifies Google ID tokens against.
GOOGLE_WEB_CLIENT_ID=446089701899-lni2flud3k84sceqm02b1su5kqs4c23d.apps.googleusercontent.com

# S3 bucket for business logo/signature uploads (IAM user needs
# s3:PutObject/GetObject/DeleteObject on this bucket).
AWS_REGION=ap-south-1
S3_BUCKET=change-me
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me

# SMTP credentials used to send password-reset codes.
EMAIL_FROM=change-me@example.com
SMTP_HOST=change-me
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=change-me
SMTP_PASS=change-me

# Optional — only needed for POST /subscriptions/verify-play-purchase.
# Google Cloud Console → IAM → Service Accounts → create one, grant it
# "Financial data" access in Play Console → Users & permissions, then
# download its JSON key and paste the whole thing here as one line.
# Leave unset until the Play Console subscription products exist — see
# DECISIONS.md.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PACKAGE_NAME=com.aglakaam.app

# Only needed for POST /auth/apple. Defaults to com.aglakaam.app in code —
# only set this if the iOS bundle identifier ever diverges from Android's.
APPLE_BUNDLE_ID=com.aglakaam.app
APPLE_IAP_KEY_ID=RLKH743GXJ
APPLE_IAP_ISSUER_ID=15cd4077-9adb-4b50-9d04-b2e9253c2ceb
APPLE_IAP_PRIVATE_KEY=
APPLE_IAP_ENVIRONMENT=production

# Optional — Agla Kaam Lead Finder
# Google Places API key (Text Search New API). If omitted, falls back to approved directory sandbox.
GOOGLE_PLACES_API_KEY=
# Daily request safety limit (default: 500)
LEAD_FINDER_DAILY_LIMIT=500
# Monthly request safety limit (default: 10000)
LEAD_FINDER_MONTHLY_LIMIT=10000
